# Backend Variables
NODE_ENV=[development|production]
PORT=[3000|5000]
# Database Variables
DB_USER=your_db_username
DB_HOST=your_db_host
DB_PASSWORD=your_db_password
DB_URL=postgres://servername:password@remote_host:5432/server_remote_db
LOCAL_DB_URL=postgres://username:password@localhost:5432/your_local_db
# Google OAuth 2.0 Keys
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
# Google Calendar
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google-calendar/callback
# GitHub OAuth 2.0 Keys
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:3000/api/v1/auth/github/callback
# Cookies
COOKIE_SECRET=your_cookie_secret
#URL de redireccion para el callback de oauth
FRONTEND_OAUTH_CALLBACK_URL=http://localhost:5173/
# Cloudinary Keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Session JWT
JWT_SECRET=your_long_random_jwt_secret
JWT_EXPIRES_IN=1d
# AES-256-GCM Encription Keys
ENCRYPTION_KEY=your_encryption_key